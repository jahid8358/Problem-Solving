#include <bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin >> t;
    while (t--)
    {
        string s;
        cin >> s;
        int y = 0, e = 0, S = 0;
 
        if (s[0] == 'y' || s[0] == 'Y')
            y++;
        if (s[1] == 'e' || s[1] == 'E')
            e++;
        if (s[2] == 's' || s[2] == 'S')
            S++;
 
        if (y == 0 || e == 0 || S == 0)
            cout << "NO
";
        else
            cout << "YES
";
    }
    return 0;
}